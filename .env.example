# VoiceTranslate — Environment Configuration

# Paths
VOICETRANSLATE_DATA_DIR=./data
VOICETRANSLATE_MODELS_DIR=./models
VOICETRANSLATE_LOGS_DIR=./logs

# Audio Devices
VOICETRANSLATE_MIC_DEVICE=
VOICETRANSLATE_LOOPBACK_DEVICE=
VOICETRANSLATE_VIRTUAL_MIC_DEVICE=

# GPU Settings
VOICETRANSLATE_DEVICE=cuda
VOICETRANSLATE_CUDA_DEVICE_ID=0
VOICETRANSLATE_VRAM_LIMIT_MB=3800

# Training Mode
VOICETRANSLATE_TRAINING_MODE=local
VOICETRANSLATE_COLAB_DRIVE_LINK=
VOICETRANSLATE_COLAB_POLL_INTERVAL_S=30

# Logging
VOICETRANSLATE_LOG_LEVEL=INFO
VOICETRANSLATE_LOG_ROTATION=10 MB

# HuggingFace
HUGGINGFACE_HUB_TOKEN=
HF_HOME=./models/hf_cache
